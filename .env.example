# Docker Compose configuration overrides.
# Copy this file to .env and adjust as needed. All values are optional —
# the defaults shown here are the same as in docker-compose.yml.

# PostgreSQL credentials (shared by the postgresql, web and consumer services)
POSTGRESQL_USERNAME=weatheruser
POSTGRESQL_PASSWORD=weatherpass
POSTGRESQL_DATABASE=weatherdb

# Host port for the web UI
WEB_PORT=8088

# Enable the /status page (true/false)
STATUS_PAGE_ENABLED=false

# Minutes past the hour (UTC) at which the producer polls Open-Meteo.
# Default is every 15 minutes. For fast testing of the data flow, set to
# every minute (see DOCKER-README.md). Note: Open-Meteo updates its
# current-weather data every 15 minutes, so faster polling only shows the
# data flowing more often — the weather values repeat until the API updates.
POLL_MINUTES_UTC=1,16,31,46

# Kafka JVM heap. Lower on a small VPS if Kafka struggles for memory.
KAFKA_HEAP_OPTS=-Xmx512m -Xms256m
